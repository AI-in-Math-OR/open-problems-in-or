# Copy to .env and adjust. Never commit .env.
UPLOAD_SEED_USERNAME=pete
UPLOAD_SEED_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://pranav-nuti.github.io

# Local defaults
HOST=127.0.0.1
PORT=8081

# Railway / Docker: set these (volume mounted at /data)
# HOST=0.0.0.0
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads
# PORT is injected by Railway

MAX_UPLOAD_BYTES=52428800
